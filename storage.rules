// storage.rules
//
// DEFAULT POLICY: deny everything.
//
// Path convention:
//   hazard-photos/{reporterUid}/{reportId}/{filename}
//
// Rules:
//   - No unauthenticated access.
//   - A reporter can upload only to their own folder (first path segment = their uid).
//   - File must be an image type and 5 MB or smaller.
//   - A reporter can read files in their own folder.
//   - Officers can read any file (via server-generated signed URLs in Phase 3A).
//   - Nobody can delete files via the client SDK.
//
// IMPORTANT: In Phase 3A, officer photo access is handled server-side via
// signed URLs generated by Cloud Functions. This is because Storage rules
// cannot read Firestore to verify officer role, and we cannot trust
// client-editable custom claims for authorization.
//
// IMPORTANT: These rules are designed for the Firebase Emulator.
// They must be reviewed and approved before deployment to production.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Deny everything by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /hazard-photos/{reporterUid}/{reportId}/{filename} {

      // Create/upload: only the owner may upload to their own folder.
      // Validates file size, type, and ownership.
      allow create: if request.auth != null
        && request.auth.uid == reporterUid
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpg|jpeg|png|gif|webp)');

      // Update: only the owner may update files in their own folder.
      // This allows metadata updates but not file replacement.
      allow update: if request.auth != null
        && request.auth.uid == reporterUid
        // Only allow metadata updates, not file content replacement
        && request.resource.size == resource.size
        && request.resource.contentType == resource.contentType;

      // Read: the owner can read their own files.
      allow read: if request.auth != null
        && request.auth.uid == reporterUid;

      // Delete: explicitly denied for all clients.
      // File deletion is a privileged operation reserved for
      // server-side Cloud Functions with proper audit trails.
      allow delete: if false;
    }
  }
}
